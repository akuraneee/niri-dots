spawn-at-startup "xwayland-sattelite"

environment {
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  GDK_SCALE "1.5"
}

prefer-no-csd

overview {
    zoom 0.3
    workspace-shadow {
        off
    }
}

output "DP-1" {
    mode "1920x180@60.0"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@100.0"
    position x=1920 y=0
}
input {
    keyboard {
       xkb {
            layout "us,ru"
            options "grp:caps_toggle"
    }
    repeat-delay 300
        repeat-rate 50
    }

    mouse {
        accel-speed -0.7
        accel-profile "flat"
    }
}

cursor {
//    hide-when-typing
}


hotkey-overlay {
    skip-at-startup
}

layer-rule {
    match namespace="swww-daemon"
    match namespace="mpvpaper"
    place-within-backdrop true
}


layout {
    gaps 10
    background-color "transparent"


    center-focused-column "on-overflow"
    always-center-single-column


    empty-workspace-above-first


    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }
    

/-    border {
        width 2
        active-color "#717191"
        inactive-color "#434c5e"
//        active-color "#434c5e"
        urgent-color "#bf616a"
    }
    border {
        off
    }

    tab-indicator {
        gap 3
//        place-within-column
    }

}

window-rule {
    match is-active=true

    shadow {
        on
        color "#717191" 
        softness 0     
        spread 2      
        offset x=0 y=0
    }
}

/-window-rule {
    match is-active=false

    shadow {
        on
        color "#434c5e" 
        softness 0
        spread 3
        offset x=0 y=0
    }
}
/-window-rule {
    match is-active=true

    shadow {
        on
        softness 10
        spread 10
        offset x=0 y=5
    }
}


spawn-at-startup "waybar"
//spawn-at-startup "swww-daemon" 
spawn-at-startup "bash" "-c" "$HOME/.config/niri/scripts/restore-wall.sh"
spawn-at-startup "swaync"
spawn-at-startup "nm-applet"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "gnome-keyring-daemon --start --components=secrets"
spawn-at-startup "copyq"
spawn-at-startup "flatpak run com.github.wwmm.easyeffects"
spawn-at-startup "flatpak run com.github.zocker_160.SyncThingy"
spawn-at-startup "steam"
layer-rule {
    match namespace="waybar"
    match at-startup=true

    opacity 0.6

    shadow {
        on
        softness 10
        spread 5
        offset x=0 y=3
    }

    geometry-corner-radius 10
}



screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {

    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    geometry-corner-radius 18
    clip-to-geometry true
    
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}


animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 250
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 250
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=550 epsilon=0.0001
    }
}


window-rule {
   draw-border-with-background false
//    match app-id="code"
    match app-id="kitty"
//    match app-id="vesktop"
//    match app-id="org.qbittorrent.qBittorrent"
//    match app-id="thunar"
//    match app-id="org.gnome.Nautilus"
//    match app-id="chromium"
//    match app-id="zathura"
//    match app-id="engrampa"
//    match app-id="abaddon"
//    match app-id="obsidian"
    match app-id="zen"
//    match app-id="tsuzuku"
//    match app-id="obs-studio"
//    match app-id="org.telegram.desktop"
    opacity 0.99
    clip-to-geometry true
}


binds {
    XF86AudioRaiseVolume allow-when-locked=true      { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02+"; }
    XF86AudioLowerVolume allow-when-locked=true      { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.02-"; }
    XF86AudioMute        allow-when-locked=true      { spawn "playerctl" "play-pause"; }
    XF86AudioMicMute     allow-when-locked=true      { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp  allow-when-locked=true      { spawn "brightnessctl" "--device=intel_backlight" "set" "+5%" ; }
    XF86MonBrightnessDown allow-when-locked=true     { spawn "brightnessctl" "--device=intel_backlight" "set" "5%-" ; }

    //core aplications and hotkeys
    Mod+Slash                                        { show-hotkey-overlay; }
    Mod+Z { spawn "bash" "-c" "tofi-drun --drun-launch=true || pkill tofi-drun";  }
    Mod+Shift+W hotkey-overlay-title="change wallpaper" { spawn "sh" "-c" "~/.config/niri/scripts/wall-choose.sh"; }
    Mod+I hotkey-overlay-title="lock" { spawn "sh" "-c" "~/.config/niri/scripts/lock.sh"; }
    Mod+Tab repeat=false hotkey-overlay-title="overview" { toggle-overview; }
    Mod+Q hotkey-overlay-title="close window"        { close-window; }
    Mod+V hotkey-overlay-title="clipboard manager"   { spawn "copyq" "toggle"; }
    Mod+U hotkey-overlay-title="toggle dnd" { spawn "bash" "-c" "swaync-client --toggle-dnd"; }
    Mod+Ctrl+V hotkey-overlay-title="run volume mixer" { spawn "pavucontrol"; }
    Mod+N hotkey-overlay-title="open notification centre" { spawn "swaync-client" "-t"; }
//    Mod+B hotkey-overlay-title="toggle blur" { spawn "~/.config/niri/scripts/toggle-blur.sh"; }
    Mod+Alt+Z hotkey-overlay-title="zoom" { spawn "bash" "-c" "wooz --invert-scroll"; }
    Mod+Alt+T                   { spawn "bash" "-c" "normcap -l eng rus"; }
    Mod+M           { spawn "gnome-system-monitor"; }

    //focus and windows moving
    Mod+H              { focus-column-left; }
    Mod+L              { focus-column-right; }
    Mod+J              { focus-window-or-workspace-down; }
    Mod+K              { focus-window-or-workspace-up; }

    Mod+Shift+H        { move-column-left; }
    Mod+Shift+L        { move-column-right; }
    Mod+Shift+J        { move-window-down-or-to-workspace-down; }
    Mod+Shift+K        { move-window-up-or-to-workspace-up; }
    
    Mod+Ctrl+L         { focus-monitor-next; }
    Mod+Ctrl+H         { focus-monitor-previous; }
    Mod+Shift+Ctrl+L   { move-column-to-monitor-previous; }
    Mod+Shift+Ctrl+H   { move-column-to-monitor-next; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    //tabs
    Mod+x { toggle-column-tabbed-display; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
  
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    //window size abjusting  
    Mod+Alt+R       { reset-window-height; } 

    Mod+D            { maximize-column; }
    Mod+F            { fullscreen-window; }

    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Shift+C      { center-column; }

    Mod+Space        { toggle-window-floating; }
    Mod+Shift+Space  { switch-focus-between-floating-and-tiling; }

    Mod+Alt+H        { set-column-width "-10%"; }
    Mod+Alt+L        { set-column-width "+10%"; }
    Mod+Alt+K        { set-window-height "-10%"; }
    Mod+Alt+J        { set-window-height "+10%"; }

    //regular apps
    Mod+W            { spawn "zen-browser"; }
    Mod+T            { spawn "obsidian"; }
    Mod+E hotkey-overlay-title="run file manager" { spawn "nautilus"; }
    Mod+RETURN hotkey-overlay-title="run a Terminal" { spawn "kitty"; }
    Mod+S hotkey-overlay-title="spotify" { spawn "spotify"; }
    Mod+A hotkey-overlay-title="ayugram" { spawn "flatpak" "run" "com.ayugram.desktop"; }
    Mod+R hotkey-overlay-title="discord" { spawn "discord"; }
    Mod+B hotkey-overlay-title="bitwarden"{ spawn "bitwarden-desktop"; }

    //utils 
    Mod+Shift+S      { screenshot; }
    Ctrl+Print       { screenshot-screen; }
    Alt+Print        { screenshot-window; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Ctrl+Alt+Delete  { quit; }
}
