// waybar — https://github.com/Alexays/Waybar/wiki
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 10,
  "margin-left": 200,
  "margin-right": 200,

  "modules-left": ["niri/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": [
    "niri/window",
    "tray",
    "pulseaudio#mic",
    "pulseaudio",
    "network#ethernet",
    "network#wifi",
    "bluetooth",
    "custom/swaync",
    "niri/language",
    "battery"
  ],

  // ─── Left ──────────────────────────────────────────────────────────────────

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "•"
    },
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down"
  },

  "mpris": {
    "format": "{status_icon} {artist} - {title}",
    "format-stopped": "",
    "title-len": 35,
    "status-icons": {
      "paused": "*"
    }
  },

  // ─── Center ────────────────────────────────────────────────────────────────

  "clock": {
    "format": "{:%H:%M %d/%m}",
    "interval": 1,
    "tooltip-format": "{:%A %d %B %Y}"
  },

  // ─── Right ─────────────────────────────────────────────────────────────────

  "niri/window": {
    "format": "<span>{title}</span>"
  },

  "tray": {
    "spacing": 12
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "󰝟",
    "on-click-right": "pavucontrol"
  },

  // Shown only while the mic is muted (empty text hides the module)
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": "󰍭",
    "tooltip-format": "Microphone muted",
    "on-click": "~/.config/niri/scripts/mic-toggle.sh"
  },

  // Pinned to physical interfaces, otherwise the module picks Mullvad's wg0 tunnel.
  // Ethernet shows only while a cable is connected
  "network#ethernet": {
    "interface": "en*",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "",
    "tooltip-format": "{ifname}  {ipaddr}/{cidr}",
    "on-click-right": "nm-connection-editor"
  },

  "network#wifi": {
    "interface": "wl*",
    "format-wifi": "{icon}",
    "format-linked": "󰤫",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Wi-Fi disconnected",
    "on-click": "~/.config/niri/scripts/wifi-menu.sh",
    "on-click-right": "nm-connection-editor"
  },

  "bluetooth": {
    "format-on": "",
    "format-off": "󰂲",
    "format-disabled": "",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {icon} {device_alias}",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format-on": "{controller_address} {controller_address_type}",
    "tooltip-format-off": "{controller_address} {controller_address_type}",
    "tooltip-format-connected": "{device_address} {controller_alias}",
    "tooltip-format-connected-battery": "{device_battery_percentage}% {device_address} {controller_alias}",
    "on-click-right": "blueman-manager"
  },

  "custom/swaync": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "niri/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ru": "RU"
  },

  // Rightmost; turns red below 20% (see style.css), plug icon while charging.
  // Dropping below 20% on battery fires a notification offering power saver
  "battery": {
    "interval": 30,
    "states": {
      "critical": 20
    },
    "events": {
      "on-discharging-critical": "~/.config/niri/scripts/battery-low.sh"
    },
    "format": "{capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "tooltip-format": "{timeTo}"
  }
}
