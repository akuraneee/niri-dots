// fastfetch — based on https://github.com/m3tozz/FastCat
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color": { "1": "0" }
  },
  "display": {
    "separator": " ",
    "key": { "color": "34" }
  },
  "modules": [
    "break",
    { "type": "os",           "key": " " },
    { "type": "kernel",       "key": " " },
    { "type": "packages",     "key": " " },
    { "type": "shell",        "key": " " },
    { "type": "terminal",     "key": " " },
    { "type": "wm",           "key": " " },
    { "type": "cursor",       "key": " " },
    { "type": "terminalfont", "key": " " },
    { "type": "uptime",       "key": " " },
    { "type": "datetime",     "key": " ", "format": "{1}-{3}-{11}" },
    { "type": "memory",       "key": "󰍛 " },
    { "type": "media",        "key": " " },
    { "type": "monitor",      "key": " " }
  ]
}
